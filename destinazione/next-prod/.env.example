# Public env exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_CONTACT_FORM_MODE=live

# Server-only env used by Next Route Handlers and server helpers
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-on-server-only
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
ADMIN_API_TOKEN=replace-on-server-only
TURNSTILE_SECRET_KEY=replace-on-server-only
APP_ENV=development
