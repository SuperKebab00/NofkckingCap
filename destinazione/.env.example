# Public/frontend-safe config
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
PUBLIC_SITE_URL=https://your-site.pages.dev
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
PUBLIC_PAYPAL_CLIENT_ID=paypal-public-client-id-placeholder

# Server-side only secrets for Cloudflare Pages Functions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-cloudflare-only
# Cloudflare root/server-only admin API secret
ADMIN_API_TOKEN=replace-in-cloudflare-only
PAYPAL_CLIENT_ID=paypal-public-client-id-placeholder
PAYPAL_CLIENT_SECRET=replace-in-cloudflare-only
PAYPAL_ENV=sandbox
STRIPE_SECRET_KEY=sk_test_replace_in_cloudflare_only
STRIPE_WEBHOOK_SECRET=whsec_replace_in_cloudflare_only
TURNSTILE_SECRET_KEY=turnstile-secret-placeholder
APP_ENV=development

# Optional bindings/secrets
RATE_LIMIT_KV=bind-a-cloudflare-kv-namespace
RESEND_API_KEY=replace-in-cloudflare-only
